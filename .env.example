# ---------------------------------------------------------------------------
# Enphase configuration. Copy to the real locations (NOT into git):
#
#   /opt/appdata/enphase/token.txt     <- gateway JWT (from enphase_get_token.py)
#   /opt/appdata/enphase/oauth.env     <- v4 API creds + tokens
#   /opt/appdata/enphase/refresh.env   <- Enlighten login for token minting
#
# All of these are gitignored.
# ---------------------------------------------------------------------------

# --- Local IQ Gateway JWT (enphase_get_token.py / refresh_enphase_token.py) ---
# ENPHASE_USER=you@example.com
# ENPHASE_PASS=...
# ENPHASE_SITE=Your Site Name
# ENPHASE_SERIAL=000000000000
# ENPHASE_TOKEN_OUT=/opt/appdata/enphase/token.txt

# --- Enphase API v4 (developer-v4.enphase.com) ---
# CLIENT_ID=...
# CLIENT_SECRET=...
# ACCESS_TOKEN=...      # expires daily (auto-refreshed)
# REFRESH_TOKEN=...     # expires ~monthly (re-authorize)
# API_KEY=...
# SYSTEM_ID=0000000

# --- Gateway ---
# ENPHASE_GATEWAY=192.168.50.194
